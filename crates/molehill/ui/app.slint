import { Theme } from "theme.slint";
import { Btn, LinkButton, Toggle, FieldLabel, Hint, Mole, Input, TextArea, Scroll, Select } from "widgets.slint";
import { ConnectionItem, ConnectionCard, FormFieldItem } from "card.slint";
import { TrayMenu, MenuTunnel } from "traymenu.slint";

export { Theme, ConnectionItem, FormFieldItem, TrayMenu, MenuTunnel }

export struct ComponentItem {
    id: string,
    name: string,
    description: string,
    version: string,
    // "install" | "update" | ""
    action: string,
    busy: bool,
    message: string,
    error: bool,
}

export enum Page { list, editor, components, log }

component Header inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    callback back();
    spacing: 8px;
    VerticalLayout {
        alignment: center;
        LinkButton { text: "←"; clicked => { root.back(); } }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            font-size: 13px;
            font-weight: 700;
            color: Theme.text;
            overflow: elide;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            font-size: 10px;
            color: Theme.muted;
            overflow: elide;
        }
    }
}

// A labelled block in the editor.
component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 5px;
    FieldLabel { text: root.label; }
    @children
}

export component AppWindow inherits Window {
    title: "Molehill";
    icon: root.app-icon;
    background: Theme.bg;
    default-font-family: Theme.mono;
    default-font-size: 12px;
    // Fixed size (close and minimize only); keep in sync with platform.rs.
    width: 380px;
    height: 560px;

    in property <image> app-icon;
    in-out property <Page> page: Page.list;

    // ── list ────────────────────────────────────────────────────────
    in property <[ConnectionItem]> connections;
    in property <string> summary: "All tunnels down";
    in property <bool> any-on;
    in property <bool> any-busy;
    in property <bool> locked;
    in property <bool> service-online;
    in property <string> notice;
    in property <bool> components-attention;
    callback master-toggle();
    callback toggle(string);
    callback edit(string);
    callback show-log(string);
    callback submit-credentials(string, int, string, string, bool);
    callback submit-text(string, int, string);
    callback cancel-prompt(string, int);
    callback open-url(string);
    callback form-field-edited(string, int, string);
    callback submit-form(string, int);
    callback new-connection();
    callback open-components();

    // ── editor ──────────────────────────────────────────────────────
    in-out property <bool> form-is-new: true;
    in-out property <string> form-name;
    in-out property <int> form-protocol;
    in-out property <string> form-config;
    in-out property <string> form-config-info;
    in-out property <string> form-gateway;
    in-out property <string> form-group;
    in-out property <string> form-username;
    in-out property <bool> form-remember;
    // Fortinet / GlobalProtect: browser SSO instead of username / password.
    in-out property <bool> form-sso;
    in-out property <string> form-error;
    // 0 = .ovpn file, 1 = Access Server, 2 = manual
    in-out property <int> form-source;
    in-out property <string> form-server;
    in-out property <bool> form-insecure;
    in-out property <bool> form-fetch-busy;
    in-out property <string> form-fetch-info;
    in-out property <string> form-host;
    in-out property <string> form-port;
    in-out property <bool> form-tcp;
    in-out property <string> form-ca;
    in-out property <int> form-tls-mode;
    in-out property <string> form-tls-key;
    in-out property <string> form-extra;
    in-out property <string> form-password;
    in-out property <bool> form-has-saved-password;
    callback browse-config();
    callback fetch-profile();
    callback browse-ca();
    callback browse-tls-key();
    callback save-profile();
    callback delete-profile();
    callback cancel-editor();

    // ── components ──────────────────────────────────────────────────
    in property <[ComponentItem]> components;
    in property <string> components-status;
    callback check-updates();
    callback install-component(string);

    // ── log ─────────────────────────────────────────────────────────
    in property <string> log-title;
    in property <string> log-text;

    VerticalLayout {
        padding: 12px;
        padding-top: 10px;
        spacing: 10px;

        // ── list page ───────────────────────────────────────────────
        if root.page == Page.list: VerticalLayout {
            spacing: 10px;

            HorizontalLayout {
                spacing: 10px;
                padding-bottom: 2px;
                VerticalLayout {
                    alignment: center;
                    Mole {
                        width: 32px;
                        height: 16px;
                        tint: root.any-on ? Theme.green : root.any-busy ? Theme.yellow : Theme.accent;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: "molehill";
                        font-size: 15px;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    Text {
                        text: root.summary;
                        font-size: 10px;
                        color: root.any-on ? Theme.green : root.any-busy ? Theme.yellow : Theme.muted;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Toggle {
                        checked: root.any-on || root.any-busy;
                        busy: root.any-busy;
                        enabled: root.connections.length > 0;
                        toggled => { root.master-toggle(); }
                    }
                }
            }

            if root.notice != "": Rectangle {
                background: Theme.yellow.transparentize(0.92);
                border-width: 1px;
                border-color: Theme.yellow.transparentize(0.55);
                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;
                    Text {
                        text: root.notice;
                        color: Theme.yellow;
                        font-size: 11px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.components-attention: VerticalLayout {
                        alignment: center;
                        Btn { text: "Open"; clicked => { root.open-components(); } }
                    }
                }
            }

            if root.connections.length == 0: VerticalLayout {
                alignment: center;
                spacing: 12px;
                vertical-stretch: 1;
                HorizontalLayout {
                    alignment: center;
                    Mole {
                        width: 96px;
                        height: 48px;
                        tint: Theme.faint;
                        eyes: Theme.muted;
                    }
                }
                Text {
                    text: "No tunnels dug yet";
                    font-size: 13px;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                Text {
                    text: "OpenVPN · Cisco AnyConnect · Fortinet · GlobalProtect";
                    font-size: 10px;
                    color: Theme.muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    Btn { text: "Add your first VPN"; kind: "primary"; clicked => { root.new-connection(); } }
                }
            }

            if root.connections.length > 0: Scroll {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 6px;
                    for item in root.connections: ConnectionCard {
                        item: item;
                        locked: root.locked;
                        toggle => { root.toggle(item.id); }
                        edit => { root.edit(item.id); }
                        show-log => { root.show-log(item.id); }
                        submit-credentials(u, p, r) => { root.submit-credentials(item.id, item.prompt-id, u, p, r); }
                        submit-text(v) => { root.submit-text(item.id, item.prompt-id, v); }
                        cancel-prompt => { root.cancel-prompt(item.id, item.prompt-id); }
                        open-url(url) => { root.open-url(url); }
                        field-edited(index, value) => { root.form-field-edited(item.id, index, value); }
                        submit-form => { root.submit-form(item.id, item.prompt-id); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 2px;
                LinkButton { text: "+ New"; clicked => { root.new-connection(); } }
                LinkButton { text: "Components"; dot: root.components-attention; clicked => { root.open-components(); } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.service-online ? "● Service" : "○ Service offline";
                        font-size: 10px;
                        color: root.service-online ? Theme.faint : Theme.red;
                    }
                }
            }
        }

        // ── editor page ─────────────────────────────────────────────
        if root.page == Page.editor: VerticalLayout {
            spacing: 10px;
            Header {
                title: root.form-is-new ? "New connection" : "Edit connection";
                back => { root.cancel-editor(); }
            }

            Scroll {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 12px;
                    padding-bottom: 4px;

                    Field {
                        label: "Name";
                        Input { placeholder: "e.g. Work VPN"; text <=> root.form-name; }
                    }

                    // Like the Omarchy plugin: the server comes right after the
                    // name, then the protocol as a dropdown that shapes the rest.
                    if root.form-protocol != 0: Field {
                        label: root.form-protocol == 3 ? "Portal" : root.form-protocol == 2 ? "Gateway (host or host:port)" : "Gateway";
                        Input {
                            placeholder: root.form-protocol == 2 ? "vpn.example.com:10443" : root.form-protocol == 1 ? "vpn.example.com or vpn.example.com/group" : "vpn.example.com";
                            text <=> root.form-gateway;
                        }
                    }

                    Field {
                        label: "Protocol";
                        Select {
                            enabled: root.form-is-new;
                            // Display order (Cisco first, as in the plugin) → protocol index.
                            model: ["Cisco AnyConnect / ocserv", "Palo Alto GlobalProtect", "Fortinet FortiGate", "OpenVPN"];
                            current-index: root.form-protocol == 1 ? 0 : root.form-protocol == 3 ? 1 : root.form-protocol == 2 ? 2 : 3;
                            selected(v) => {
                                root.form-protocol = v == "Cisco AnyConnect / ocserv" ? 1 : v == "Palo Alto GlobalProtect" ? 3 : v == "Fortinet FortiGate" ? 2 : 0;
                                root.form-error = "";
                            }
                        }
                    }

                    if root.form-protocol == 0: Field {
                        label: "Set up from";
                        Select {
                            model: ["A .ovpn file", "OpenVPN Access Server (fetch the profile)", "Manual (address, CA, keys)"];
                            current-index: root.form-source;
                            selected(v) => {
                                root.form-source = v == "A .ovpn file" ? 0 : v == "Manual (address, CA, keys)" ? 2 : 1;
                                root.form-error = "";
                            }
                        }
                    }

                    if root.form-protocol >= 2: Field {
                        label: "Sign-in";
                        Select {
                            model: ["Username & password (+ code / token)", "Browser SSO (Microsoft, Okta, Google…)"];
                            current-index: root.form-sso ? 1 : 0;
                            selected(v) => { root.form-sso = v != "Username & password (+ code / token)"; }
                        }
                        Hint {
                            text: root.form-sso
                                ? (root.form-protocol == 3 ? "Signs in through your default browser, which hands the result back to Molehill."
                                    : "Opens the FortiGate SSO page in your default browser; it hands back to 127.0.0.1:8020.")
                                : (root.form-protocol == 3 ? "Codes from SMS, email or a token app are asked for at sign-in."
                                    : "Codes from SMS, email or FortiToken are asked for at sign-in. Leave the code empty for a push.");
                        }
                    }

                    // .ovpn file
                    if root.form-protocol == 0 && root.form-source == 0: Field {
                        label: "Profile (.ovpn)";
                        HorizontalLayout {
                            spacing: 6px;
                            Input {
                                placeholder: "The file your provider or IT gave you";
                                text: root.form-config;
                                read-only: true;
                                horizontal-stretch: 1;
                            }
                            Btn { text: "Browse"; clicked => { root.browse-config(); } }
                        }
                        if root.form-config-info != "": Hint { text: root.form-config-info; }
                    }

                    // OpenVPN Access Server
                    if root.form-protocol == 0 && root.form-source == 1: Field {
                        label: "Server address";
                        HorizontalLayout {
                            spacing: 6px;
                            Input {
                                placeholder: "vpn.example.com";
                                text <=> root.form-server;
                                horizontal-stretch: 1;
                            }
                            Btn {
                                text: root.form-fetch-busy ? "Fetching…" : "Fetch";
                                enabled: !root.form-fetch-busy;
                                clicked => { root.fetch-profile(); }
                            }
                        }
                        Hint {
                            text: root.form-fetch-info != "" ? root.form-fetch-info
                                : "Signs in with the username and password below and downloads your profile, like OpenVPN Connect.";
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            padding-top: 2px;
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked: root.form-insecure; toggled => { root.form-insecure = !root.form-insecure; } }
                            }
                            Text {
                                text: "Accept a self-signed web certificate";
                                color: Theme.text;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Manual
                    if root.form-protocol == 0 && root.form-source == 2: VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 6px;
                            Field {
                                label: "Server address";
                                horizontal-stretch: 1;
                                Input { placeholder: "vpn.example.com"; text <=> root.form-host; }
                            }
                            Field {
                                label: "Port";
                                horizontal-stretch: 0;
                                Input { width: 72px; placeholder: "1194"; text <=> root.form-port; }
                            }
                        }
                        Field {
                            label: "Transport";
                            Select {
                                model: ["UDP", "TCP"];
                                current-index: root.form-tcp ? 1 : 0;
                                selected(v) => { root.form-tcp = v == "TCP"; }
                            }
                        }
                        VerticalLayout {
                            spacing: 5px;
                            HorizontalLayout {
                                FieldLabel { text: "CA certificate"; vertical-alignment: center; horizontal-stretch: 1; }
                                LinkButton { text: "Load file…"; clicked => { root.browse-ca(); } }
                            }
                            TextArea {
                                height: 76px;
                                placeholder: "-----BEGIN CERTIFICATE-----";
                                text <=> root.form-ca;
                            }
                        }
                        VerticalLayout {
                            spacing: 5px;
                            HorizontalLayout {
                                FieldLabel { text: "TLS key, if the server uses one"; vertical-alignment: center; horizontal-stretch: 1; }
                                if root.form-tls-mode != 0: LinkButton { text: "Load file…"; clicked => { root.browse-tls-key(); } }
                            }
                            Select {
                                model: ["None", "tls-auth", "tls-crypt"];
                                current-index: root.form-tls-mode;
                                selected(v) => { root.form-tls-mode = v == "tls-auth" ? 1 : v == "tls-crypt" ? 2 : 0; }
                            }
                            if root.form-tls-mode != 0: TextArea {
                                height: 76px;
                                placeholder: "-----BEGIN OpenVPN Static key V1-----";
                                text <=> root.form-tls-key;
                            }
                        }
                        Field {
                            label: "Extra directives (optional)";
                            TextArea {
                                height: 56px;
                                placeholder: "cipher AES-256-GCM";
                                text <=> root.form-extra;
                            }
                        }
                    }

                    if root.form-protocol != 0: Field {
                        label: root.form-protocol == 2 ? "Realm (optional)" : root.form-protocol == 3 ? "Gateway (optional)" : "Group (optional)";
                        Input {
                            placeholder: root.form-protocol == 2 ? "Only if your IT gave you one" : "Asked at sign-in, then remembered";
                            text <=> root.form-group;
                        }
                    }

                    if !(root.form-protocol >= 2 && root.form-sso): HorizontalLayout {
                        spacing: 6px;
                        Field {
                            label: "Username";
                            horizontal-stretch: 1;
                            Input { placeholder: "Optional"; text <=> root.form-username; }
                        }
                        Field {
                            label: "Password";
                            horizontal-stretch: 1;
                            Input {
                                placeholder: root.form-has-saved-password ? "Saved · leave empty to keep it" : "Optional";
                                input-type: password;
                                text <=> root.form-password;
                            }
                        }
                    }

                    if !(root.form-protocol >= 2 && root.form-sso): HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Toggle { checked: root.form-remember; toggled => { root.form-remember = !root.form-remember; } }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: "Remember password"; color: Theme.text; font-size: 11px; }
                            Hint { text: "In Windows Credential Manager. Otherwise asked each time."; }
                        }
                    }

                    if root.form-error != "": Text {
                        text: root.form-error;
                        color: Theme.red;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                if !root.form-is-new: Btn { text: "Delete"; kind: "danger"; clicked => { root.delete-profile(); } }
                Rectangle { horizontal-stretch: 1; }
                Btn { text: "Cancel"; clicked => { root.cancel-editor(); } }
                Btn {
                    text: root.form-fetch-busy ? "Fetching…" : "Save";
                    kind: "primary";
                    enabled: !root.form-fetch-busy;
                    clicked => { root.save-profile(); }
                }
            }
        }

        // ── components page ─────────────────────────────────────────
        if root.page == Page.components: VerticalLayout {
            spacing: 10px;
            Header {
                title: "Components";
                subtitle: "The engines Molehill drives, kept up to date";
                back => { root.page = Page.list; }
            }

            Scroll {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 6px;
                    for c in root.components: Rectangle {
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: c.action == "update" ? Theme.yellow.transparentize(0.5) : Theme.border;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text { text: c.name; font-size: 12px; font-weight: 700; color: Theme.text; }
                                    Text { text: c.description; font-size: 10px; color: Theme.muted; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    if c.action == "install": Btn { text: c.busy ? "Installing…" : "Install"; kind: "primary"; enabled: !c.busy; clicked => { root.install-component(c.id); } }
                                    if c.action == "update": Btn { text: c.busy ? "Updating…" : "Update"; kind: "primary"; enabled: !c.busy; clicked => { root.install-component(c.id); } }
                                }
                            }
                            Text {
                                text: c.version;
                                font-size: 10px;
                                color: c.action == "update" ? Theme.yellow : c.action == "install" ? Theme.red : Theme.green;
                            }
                            if c.message != "": Text {
                                text: c.message;
                                font-size: 10px;
                                color: c.error ? Theme.red : Theme.muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { text: root.components-status; font-size: 10px; color: Theme.muted; wrap: word-wrap; }
                }
                Btn { text: "Check for updates"; enabled: root.service-online; clicked => { root.check-updates(); } }
            }
        }

        // ── log page ────────────────────────────────────────────────
        if root.page == Page.log: VerticalLayout {
            spacing: 10px;
            Header {
                title: root.log-title;
                subtitle: "VPN engine output from this session";
                back => { root.page = Page.list; }
            }
            TextArea {
                read-only: true;
                wrap: false;
                text: root.log-text;
                font-size: 10px;
                vertical-stretch: 1;
            }
        }
    }
}
