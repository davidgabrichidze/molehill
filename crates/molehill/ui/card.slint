import { Theme } from "theme.slint";
import { Btn, LinkButton, Toggle, Badge, FieldLabel, Input, Select, Check } from "widgets.slint";

export struct FormFieldItem {
    name: string,
    label: string,
    // "text" | "password" | "select"
    kind: string,
    value: string,
    options: [string],
    selected: int,
    focus: bool,
    // Already filled by Molehill (the saved password); empty keeps it.
    prefilled: bool,
}

export struct ConnectionItem {
    id: string,
    name: string,
    tag: string,
    // "off" | "busy" | "on" | "error"
    state: string,
    status: string,
    info: string,
    // "" | "credentials" | "text" | "url" | "form" | "cert"
    prompt-kind: string,
    prompt-id: int,
    prompt-label: string,
    prompt-echo: bool,
    prompt-username: string,
    prompt-message: string,
    prompt-url: string,
    prompt-fields: [FormFieldItem],
    prompt-pin: string,
    remember: bool,
}

// Server text above a prompt.
component Note inherits Text {
    in property <bool> error;
    color: root.error ? Theme.red : Theme.muted;
    font-size: 11px;
    wrap: word-wrap;
}

export component ConnectionCard inherits Rectangle {
    in property <ConnectionItem> item;
    // Another sign-in is in progress; only one runs at a time.
    in property <bool> locked;
    callback toggle();
    callback edit();
    callback show-log();
    callback submit-credentials(string, string, bool);
    callback submit-text(string);
    callback cancel-prompt();
    callback open-url(string);
    callback field-edited(int, string);
    callback submit-form();

    property <string> user: root.item.prompt-username;
    property <string> secret;
    property <bool> remember: root.item.remember;
    // Typing breaks the bindings above, so a new prompt (a retry after a
    // wrong password, say) refreshes them by hand.
    property <int> seen-prompt;
    changed item => {
        if root.item.prompt-id != root.seen-prompt {
            root.seen-prompt = root.item.prompt-id;
            root.user = root.item.prompt-username;
            root.secret = "";
            root.remember = root.item.remember;
        }
    }
    property <color> state-color: root.item.state == "on" ? Theme.green
        : root.item.state == "busy" ? Theme.yellow
        : root.item.state == "error" ? Theme.red : Theme.muted;

    function send-credentials() {
        root.submit-credentials(root.user, root.secret, root.remember);
        root.secret = "";
    }
    function send-text() {
        root.submit-text(root.secret);
        root.secret = "";
    }

    background: Theme.surface;
    border-width: 1px;
    border-color: root.item.prompt-kind != "" ? Theme.accent
        : root.item.state == "on" ? Theme.green.transparentize(0.5) : Theme.border;
    animate border-color { duration: 200ms; }

    // A bar on the left in the state colour, Omarchy-style.
    Rectangle {
        x: 0;
        width: 2px;
        background: root.item.prompt-kind != "" ? Theme.accent : root.item.state == "off" ? transparent : root.state-color;
    }

    VerticalLayout {
        padding: 10px;
        padding-left: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Badge { text: root.item.tag; tint: root.item.state == "on" ? Theme.green : Theme.accent; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 1;
                Text {
                    text: root.item.name;
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: root.item.status;
                    font-size: 10px;
                    color: root.state-color;
                    overflow: elide;
                    wrap: root.item.state == "error" ? TextWrap.word-wrap : TextWrap.no-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    LinkButton { text: "log"; clicked => { root.show-log(); } }
                    LinkButton { text: "edit"; clicked => { root.edit(); } }
                }
            }
            VerticalLayout {
                alignment: center;
                Toggle {
                    checked: root.item.state == "on" || root.item.state == "busy";
                    busy: root.item.state == "busy";
                    enabled: !root.locked || root.item.state != "off";
                    toggled => { root.toggle(); }
                }
            }
        }

        if root.item.info != "": Text {
            text: root.item.info;
            font-size: 10px;
            color: Theme.muted;
        }

        if root.item.prompt-kind == "credentials": VerticalLayout {
            spacing: 6px;
            init => {
                if root.user == "" { u.focus(); } else { p.focus(); }
            }
            if root.item.prompt-message != "": Note { text: root.item.prompt-message; error: true; }
            u := Input {
                placeholder: "username";
                text <=> root.user;
            }
            p := Input {
                placeholder: "password";
                input-type: password;
                text <=> root.secret;
                accepted => { root.send-credentials(); }
            }
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Check { text: "remember"; checked <=> root.remember; }
                }
                Rectangle { horizontal-stretch: 1; }
                Btn { text: "cancel"; clicked => { root.cancel-prompt(); } }
                Btn { text: "sign in"; kind: "primary"; clicked => { root.send-credentials(); } }
            }
        }

        if root.item.prompt-kind == "text": VerticalLayout {
            spacing: 6px;
            Note { text: root.item.prompt-label; }
            Input {
                input-type: root.item.prompt-echo ? InputType.text : InputType.password;
                text <=> root.secret;
                accepted => { root.send-text(); }
                init => { self.focus(); }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                Btn { text: "cancel"; clicked => { root.cancel-prompt(); } }
                Btn { text: "continue"; kind: "primary"; clicked => { root.send-text(); } }
            }
        }

        if root.item.prompt-kind == "url": VerticalLayout {
            spacing: 6px;
            Note { text: "Finish signing in in your browser. The tunnel comes up by itself."; }
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                Btn { text: "cancel"; clicked => { root.cancel-prompt(); } }
                Btn { text: "open sign-in page"; kind: "primary"; clicked => { root.open-url(root.item.prompt-url); } }
            }
        }

        // A login form from the server: group, username, password, token…
        if root.item.prompt-kind == "form": VerticalLayout {
            spacing: 6px;
            if root.item.prompt-label != "": Note { text: root.item.prompt-label; }
            if root.item.prompt-message != "": Note { text: root.item.prompt-message; error: true; }
            if root.item.prompt-fields.length == 0: Note {
                text: "Nothing to type here. If the server asked you to approve the sign-in on your phone or in an app, do that first, then continue.";
            }
            for f[i] in root.item.prompt-fields: VerticalLayout {
                spacing: 4px;
                FieldLabel { text: f.label; }
                if f.kind == "select": Select {
                    model: f.options;
                    current-index: f.selected;
                    selected(v) => { root.field-edited(i, v); }
                }
                if f.kind != "select": Input {
                    text: f.value;
                    input-type: f.kind == "password" ? InputType.password : InputType.text;
                    placeholder: f.prefilled ? "saved · empty uses it" : "";
                    edited(t) => { root.field-edited(i, t); }
                    accepted => { root.submit-form(); }
                    init => {
                        if f.focus { self.focus(); }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                Btn { text: "cancel"; clicked => { root.cancel-prompt(); } }
                Btn {
                    text: root.item.prompt-fields.length == 0 ? "continue" : "sign in";
                    kind: "primary";
                    clicked => { root.submit-form(); }
                }
            }
        }

        // The server's certificate isn't trusted by Windows.
        if root.item.prompt-kind == "cert": VerticalLayout {
            spacing: 6px;
            Text {
                text: "Windows doesn't trust this server's certificate (" + root.item.prompt-label + ").";
                color: Theme.yellow;
                font-size: 11px;
                wrap: word-wrap;
            }
            Note {
                text: "Only continue if you expected this, for example because your company uses its own certificates. Molehill remembers your choice for this connection.";
            }
            Text {
                text: root.item.prompt-pin;
                font-size: 9px;
                color: Theme.faint;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                Btn { text: "cancel"; clicked => { root.cancel-prompt(); } }
                Btn { text: "trust and connect"; kind: "primary"; clicked => { root.submit-text("trust"); } }
            }
        }
    }
}
