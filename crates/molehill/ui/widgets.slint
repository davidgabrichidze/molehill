import { Theme } from "theme.slint";

export component Btn inherits Rectangle {
    in property <string> text;
    // "primary" | "ghost" | "danger"
    in property <string> kind: "ghost";
    in property <bool> enabled: true;
    callback clicked();
    horizontal-stretch: 0;

    height: 28px;
    border-radius: Theme.radius;
    background: !root.enabled ? transparent
        : root.kind == "primary" ? (ta.has-hover ? Theme.accent.brighter(0.12) : Theme.accent)
        : root.kind == "danger" ? (ta.has-hover ? Theme.red.transparentize(0.85) : transparent)
        : (ta.has-hover ? Theme.surface-hover : transparent);
    border-width: root.kind == "primary" && root.enabled ? 0px : 1px;
    border-color: root.kind == "danger" ? Theme.red.transparentize(0.4)
        : ta.has-hover && root.enabled ? Theme.muted : Theme.border;
    opacity: root.enabled ? 1 : 0.45;
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            color: root.kind == "primary" && root.enabled ? Theme.on-accent : root.kind == "danger" ? Theme.red : Theme.text;
            font-family: Theme.mono;
            font-size: 12px;
            font-weight: root.kind == "primary" ? 700 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Small monospace text action, e.g. "edit".
export component LinkButton inherits Rectangle {
    in property <string> text;
    in property <bool> dot;
    callback clicked();
    horizontal-stretch: 0;
    background: ta.has-hover ? Theme.surface-hover : transparent;

    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 5px;
        Text {
            text: root.text;
            font-family: Theme.mono;
            font-size: 11px;
            color: ta.has-hover ? Theme.accent : Theme.muted;
            vertical-alignment: center;
        }
        if root.dot: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 5px;
                height: 5px;
                background: Theme.yellow;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> busy;
    in property <bool> enabled: true;
    callback toggled();

    width: 34px;
    height: 18px;
    border-radius: Theme.radius;
    background: root.busy ? Theme.yellow.transparentize(0.8) : root.checked ? Theme.accent : transparent;
    border-width: root.checked && !root.busy ? 0px : 1px;
    border-color: root.busy ? Theme.yellow : ta.has-hover ? Theme.text : Theme.muted;
    opacity: root.enabled ? 1 : 0.35;
    animate background { duration: 150ms; }

    Rectangle {
        width: 10px;
        height: 10px;
        y: (parent.height - self.height) / 2;
        x: root.checked ? parent.width - self.width - 4px : 4px;
        background: root.busy ? Theme.yellow : root.checked ? Theme.on-accent : (ta.has-hover ? Theme.text : Theme.muted);
        opacity: root.busy ? 0.55 + 0.45 * Math.sin(animation-tick() / 3ms * 1deg) : 1;
        animate x { duration: 140ms; easing: ease-out; }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.accent;
    width: 46px;
    height: 18px;
    border-width: 1px;
    border-color: root.tint.transparentize(0.55);
    Text {
        text: root.text;
        font-family: Theme.mono;
        font-size: 9px;
        font-weight: 700;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component FieldLabel inherits Text {
    font-family: Theme.mono;
    font-size: 11px;
    color: Theme.muted;
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <string> note;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();

    height: 28px;
    border-radius: Theme.radius;
    background: root.selected ? Theme.accent.transparentize(0.88) : ta.has-hover && root.enabled ? Theme.surface-hover : transparent;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.border;
    opacity: root.enabled || root.selected ? 1 : 0.4;

    VerticalLayout {
        alignment: center;
        padding-left: 4px;
        padding-right: 4px;
        Text {
            text: root.text;
            font-family: Theme.mono;
            font-size: 11px;
            color: root.selected ? Theme.accent : Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
        if root.note != "": Text {
            text: root.note;
            font-family: Theme.mono;
            font-size: 8px;
            color: Theme.muted;
            horizontal-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

/// Single-line text box. Placeholder in its own dim colour; the text slides
/// to keep the cursor in view, like Slint's own LineEdit.
export component Input inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> ti.text;
    in property <InputType> input-type: InputType.text;
    in property <bool> read-only <=> ti.read-only;
    in property <length> font-size: 12px;
    out property <bool> has-focus: ti.has-focus;
    callback accepted();
    callback edited(string);

    height: 28px;
    min-width: 40px;
    background: root.read-only ? transparent : Theme.field;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.accent : Theme.border;
    border-radius: Theme.radius;
    forward-focus: ti;

    Rectangle {
        x: 8px;
        width: parent.width - 16px;
        clip: true;
        if root.text == "": Text {
            width: 100%;
            height: 100%;
            text: root.placeholder;
            color: Theme.placeholder;
            font-family: Theme.mono;
            font-size: root.font-size;
            vertical-alignment: center;
            overflow: elide;
        }
        ti := TextInput {
            property <length> computed-x;
            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            height: 100%;
            vertical-alignment: center;
            single-line: true;
            input-type: root.input-type;
            color: root.read-only ? Theme.muted : Theme.text;
            font-family: Theme.mono;
            font-size: root.font-size;
            selection-background-color: Theme.accent.transparentize(0.55);
            selection-foreground-color: Theme.text;
            cursor-position-changed(p) => {
                if p.x + self.computed-x < 0px {
                    self.computed-x = - p.x;
                } else if p.x + self.computed-x > parent.width - self.text-cursor-width {
                    self.computed-x = parent.width - p.x - self.text-cursor-width;
                }
            }
            accepted => { root.accepted(); }
            edited => { root.edited(self.text); }
        }
    }
}

/// Multi-line text box (certificates, keys, the log). Scrolls with the
/// wheel and follows the cursor.
export component TextArea inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> ti.text;
    in property <bool> read-only <=> ti.read-only;
    in property <bool> wrap: true;
    in property <length> font-size: 11px;

    background: Theme.field;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.accent : Theme.border;
    border-radius: Theme.radius;
    forward-focus: ti;

    if root.text == "": Text {
        x: 8px;
        y: 6px;
        width: parent.width - 16px;
        text: root.placeholder;
        color: Theme.placeholder;
        font-family: Theme.mono;
        font-size: root.font-size;
        overflow: elide;
    }
    f := Flickable {
        x: 8px;
        y: 6px;
        width: parent.width - 16px;
        height: parent.height - 12px;
        content-width: root.wrap ? self.width : max(self.width, ti.preferred-width + 8px);
        content-height: max(self.height, ti.preferred-height);
        ti := TextInput {
            width: f.content-width;
            single-line: false;
            wrap: root.wrap ? TextWrap.word-wrap : TextWrap.no-wrap;
            color: Theme.text;
            font-family: Theme.mono;
            font-size: root.font-size;
            selection-background-color: Theme.accent.transparentize(0.55);
            selection-foreground-color: Theme.text;
            cursor-position-changed(p) => {
                if p.y + f.content-y < 0px {
                    f.content-y = - p.y;
                } else if p.y + f.content-y > f.height - root.font-size * 1.6 {
                    f.content-y = f.height - root.font-size * 1.6 - p.y;
                }
            }
        }
    }
    if f.content-height > f.height: Rectangle {
        x: parent.width - 3px;
        width: 2px;
        height: max(16px, f.height * f.height / f.content-height);
        y: 1px + (- f.content-y) * (parent.height - 2px - self.height) / max(1px, f.content-height - f.height);
        background: Theme.faint;
    }
}

/// A choice list that opens below itself.
export component Select inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    callback selected(string);

    height: 28px;
    background: Theme.field;
    border-width: 1px;
    border-color: ta.has-hover && root.enabled ? Theme.muted : Theme.border;
    border-radius: Theme.radius;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            text: root.model[root.current-index];
            color: root.enabled ? Theme.text : Theme.muted;
            font-family: Theme.mono;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: root.enabled ? "▾" : "";
            color: Theme.muted;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height;
        width: root.width;
        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.accent;
            VerticalLayout {
                padding: 1px;
                for option[i] in root.model: Rectangle {
                    height: 26px;
                    background: ota.has-hover ? Theme.surface-hover : i == root.current-index ? Theme.accent.transparentize(0.88) : transparent;
                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 100%;
                        text: option;
                        color: i == root.current-index ? Theme.accent : Theme.text;
                        font-family: Theme.mono;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    ota := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = i;
                            root.selected(option);
                        }
                    }
                }
            }
        }
    }
}

/// [x] checkbox with a label.
export component Check inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled();
    horizontal-stretch: 0;
    min-height: 18px;

    HorizontalLayout {
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 13px;
                height: 13px;
                border-width: 1px;
                border-color: root.checked ? Theme.accent : ta.has-hover ? Theme.text : Theme.muted;
                background: root.checked ? Theme.accent : transparent;
                Text {
                    text: root.checked ? "✓" : "";
                    color: Theme.on-accent;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-family: Theme.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

/// Vertical scrolling for a page, with a hairline position bar instead of
/// Windows' scroll bar.
export component Scroll inherits Rectangle {
    // Where the content really ends, if the page reports it (the list does,
    // from its last card). Slint's reported preferred height counts wrapped
    // text as one line, so it can fall short; the laid-out cards are right.
    in-out property <length> extent: 0px;
    // How far the content can move, and the thumb's size and travel.
    property <length> range: max(0px, f.content-height - f.height);
    property <length> thumb: max(24px, root.height * f.height / max(1px, f.content-height));
    property <length> thumb-y: root.range > 0 ? (- f.content-y) * (root.height - root.thumb) / root.range : 0px;
    f := Flickable {
        width: 100%;
        height: 100%;
        // Desktop scrolling: the wheel and the bar. Dragging the content
        // would steal the drag from the cards' reorder grip.
        interactive: false;
        content-height: max(self.height, root.extent > 0 ? root.extent : content.preferred-height);
        content := VerticalLayout {
            width: f.width - 10px;
            // At least as tall as the content really is (see extent).
            height: max(f.height, root.extent > 0 ? root.extent : self.preferred-height);
            alignment: start;
            @children
        }
    }
    if root.range > 0: Rectangle {
        x: parent.width - 4px;
        width: 4px;
        height: root.thumb;
        y: root.thumb-y;
        background: track.has-hover || track.pressed ? Theme.muted : Theme.faint;
    }
    // The track takes the drag (the thumb moves under the pointer). Grab the
    // thumb where it was pressed; a press beside it jumps there.
    track := TouchArea {
        x: parent.width - 8px;
        width: 8px;
        enabled: root.range > 0;
        property <length> grab;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                self.grab = self.mouse-y >= root.thumb-y && self.mouse-y <= root.thumb-y + root.thumb ? self.mouse-y - root.thumb-y : root.thumb / 2;
                root.scroll-to(self.mouse-y - self.grab);
            }
        }
        moved => { root.scroll-to(self.mouse-y - self.grab); }
    }
    // Scrolls just enough to show content from `y` to `y + h`.
    public function reveal(y: length, h: length) {
        if y + f.content-y < 0 {
            f.content-y = - y;
        } else if y + h + f.content-y > f.height {
            f.content-y = max(- root.range, f.height - y - min(h, f.height));
        }
    }
    function scroll-to(thumb-y: length) {
        f.content-y = - max(0px, min(root.range, thumb-y * root.range / max(1px, root.height - root.thumb)));
    }
}

// The Molehill mark: layered hill arches, a tunnel, two eyes and a coral
// nose (docs/brand/svg/logos/molehill-mark-tokyo-blue.svg). `tint` is the
// middle arch, which follows the VPN state.
export component Mole inherits Rectangle {
    in property <color> tint: Theme.accent;
    in property <color> outer: Theme.mark-outer;
    in property <color> inner: #414868;
    in property <color> hole: Theme.mark-hole;
    in property <color> sides: #c0caf5;
    in property <color> eyes: #f4f4f8;
    in property <color> nose: #ff9e8a;

    // The drawing spans x 2…62, y 30…58 of the 64 grid.
    Path { viewbox-x: 2; viewbox-y: 30; viewbox-width: 60; viewbox-height: 28; commands: "M7 56 A25 25 0 0 1 57 56 Z"; fill: root.outer; }
    Path { viewbox-x: 2; viewbox-y: 30; viewbox-width: 60; viewbox-height: 28; commands: "M14 56 A18 18 0 0 1 50 56 Z"; fill: root.tint; animate fill { duration: 250ms; } }
    Path { viewbox-x: 2; viewbox-y: 30; viewbox-width: 60; viewbox-height: 28; commands: "M21 56 A11 13 0 0 1 43 56 Z"; fill: root.inner; }
    Path { viewbox-x: 2; viewbox-y: 30; viewbox-width: 60; viewbox-height: 28; commands: "M25 56 A7 9 0 0 1 39 56 Z"; fill: root.hole; }
    Path { viewbox-x: 2; viewbox-y: 30; viewbox-width: 60; viewbox-height: 28; commands: "M2 56 Q8 51 14 56 L14 58 L2 58 Z M50 56 Q56 51 62 56 L62 58 L50 58 Z"; fill: root.sides; }
    Path {
        viewbox-x: 2; viewbox-y: 30; viewbox-width: 60; viewbox-height: 28;
        commands: "M27.85 49 A2.15 2.15 0 1 0 32.15 49 A2.15 2.15 0 1 0 27.85 49 Z M34.85 49 A2.15 2.15 0 1 0 39.15 49 A2.15 2.15 0 1 0 34.85 49 Z";
        fill: root.eyes;
    }
    // The nose: an ellipse tilted by -25°, drawn as two arcs.
    Path {
        viewbox-x: 2; viewbox-y: 30; viewbox-width: 60; viewbox-height: 28;
        commands: "M40.237 51.321 A3.6 2.8 -25 1 1 46.763 48.279 A3.6 2.8 -25 1 1 40.237 51.321 Z";
        fill: root.nose;
    }
}

export component Hint inherits Text {
    font-family: Theme.mono;
    font-size: 10px;
    color: Theme.muted;
    wrap: word-wrap;
}
