<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Molehill service: runs VPN tunnels as root for the Molehill app.
     Installed to /Library/LaunchDaemons by the .pkg. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.giorgobiani.molehill.service</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/molehill/bin/molehill-service</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Come back after a crash instead of leaving the VPN unusable. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <!-- Shutdown waits up to 25 s for the engines to restore routes and DNS. -->
    <key>ExitTimeOut</key>
    <integer>30</integer>
    <!-- Left false on purpose: when the daemon dies in any way, launchd kills
         the engines with it (the job object's job on Windows). -->
    <key>AbandonProcessGroup</key>
    <false/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/Molehill/service.stderr.log</string>
</dict>
</plist>
